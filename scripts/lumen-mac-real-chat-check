#!/usr/bin/env python3
"""One real-provider Lumen chat check through isolated patched Hermes."""

import json
import os
from pathlib import Path
import re
import runpy
import secrets
import shutil
import subprocess
import sys
import tempfile
from urllib.parse import urlparse

ROOT = Path(__file__).resolve().parent.parent
helpers = runpy.run_path(str(ROOT / "scripts/lumen-mac-chat-check"))
run, free_port, wait_hermes, wait_ready = (helpers[name] for name in
                                          ("run", "free_port", "wait_hermes", "wait_ready"))


def hermes_route():
    python = Path(os.getenv("LUMEN_HERMES_PYTHON", Path.home() / ".hermes/hermes-agent/venv/bin/python"))
    code = """import json, pathlib
from hermes_cli.config import reload_env
from hermes_cli.runtime_provider import resolve_runtime_provider, _get_model_config
home=pathlib.Path.home()/'.hermes'
reload_env()
model=_get_model_config()
runtime=resolve_runtime_provider()
if runtime.get('provider')!='custom' or not runtime.get('api_key') or not runtime.get('base_url'):
    raise SystemExit('Hermes active route is not a credentialed custom provider')
print(json.dumps({'model':model['default'],'url':runtime['base_url'],'key':runtime['api_key']}))
"""
    result = subprocess.run([str(python), "-c", code], capture_output=True, text=True, timeout=10)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Hermes model route unavailable")
    route = json.loads(result.stdout)
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,127}", route["model"]):
        raise RuntimeError("Hermes model name is unsupported by the isolated chat profile")
    url = urlparse(route["url"])
    if url.scheme != "https" or not url.hostname or url.port or url.username or url.password or url.query or url.fragment or not url.path:
        raise RuntimeError("Hermes model route must be plain HTTPS")
    return route


def provider_error_class(container):
    result = subprocess.run(["docker", "logs", container], capture_output=True, text=True)
    logs = result.stdout + result.stderr
    for code, label in ((401, "provider_authentication_failed"), (403, "provider_request_forbidden"),
                        (429, "provider_rate_limited")):
        if re.search(rf"HTTP\s*{code}|Error code:\s*{code}", logs, re.IGNORECASE):
            return label
    if re.search(r"HTTP\s*5\d\d|Error code:\s*5\d\d", logs, re.IGNORECASE):
        return "provider_server_error"
    if re.search(r"ConnectError|Connection refused|Name or service not known", logs, re.IGNORECASE):
        return "provider_unreachable"
    return "provider_error_unclassified"


def main():
    prompt = " ".join(sys.argv[1:]) or "Hello from Lumen. Reply with a short greeting."
    route = hermes_route()
    image = "lumen-hermes-chat:gate-test"
    probe = json.loads(run(sys.executable, str(ROOT / "integrations/hermes/container_chat_probe.py"), "--image", image))
    if probe.get("status") != "container_probe_passed":
        raise RuntimeError("pinned chat image probe failed")
    work = Path(tempfile.mkdtemp(prefix="lumen-real-chat-"))
    container = ""
    host = None
    log = None
    failed = True
    try:
        binary = work / "lumen-host"
        run("go", "build", "-o", str(binary), "./cmd/lumen-host")
        token = secrets.token_urlsafe(32)
        for name, content in (("chat.token", token), ("hermes.token", token),
                              ("provider.key", route["key"])):
            path = work / name
            path.write_text(content)
            path.chmod(0o600)
        probe_path = work / "probe.json"
        probe_path.write_text(json.dumps(probe))
        probe_path.chmod(0o600)
        env_path = work / "container.env"
        env_path.write_text("\n".join((
            "HERMES_HOME=/var/lib/hermes", "TERMINAL_CWD=/var/lib/hermes",
            "HERMES_SAFE_MODE=1", "LUMEN_CHAT_ZERO_TOOL=1", "API_SERVER_ENABLED=true",
            "API_SERVER_HOST=0.0.0.0", "API_SERVER_PORT=8642", f"API_SERVER_KEY={token}",
            f"API_SERVER_MODEL_NAME={route['model']}", "HERMES_INFERENCE_PROVIDER=custom",
            f"HERMES_INFERENCE_MODEL={route['model']}",
            f"OPENAI_API_KEY={route['key']}", f"OPENROUTER_API_KEY={route['key']}",
            f"OPENAI_BASE_URL={route['url']}", f"OPENROUTER_BASE_URL={route['url']}",
        )) + "\n")
        env_path.chmod(0o600)
        port = free_port()
        api = f"http://127.0.0.1:{port}"
        base_config = (ROOT / "integrations/hermes/chat-config.yaml").read_bytes()
        config = work / "chat-config.yaml"
        config.write_bytes(base_config + (f'\nmodel:\n  default: "{route["model"]}"\n').encode())
        config.chmod(0o600)
        dynamic_probe = json.loads(run(sys.executable, str(ROOT / "integrations/hermes/container_chat_probe.py"),
                                       "--image", image, "--config", str(config), "--model", route["model"]))
        if dynamic_probe.get("status") != "container_probe_passed":
            raise RuntimeError("Hermes route configuration failed its synthetic model probe")
        container = run("docker", "run", "--detach", "--rm", "--read-only",
                        "--user", "65532:65532", "--tmpfs", "/var/lib/hermes:rw,uid=65532,gid=65532,mode=0700",
                        "--mount", f"type=bind,src={config},dst=/var/lib/hermes/config.yaml,readonly",
                        "--publish", f"127.0.0.1:{port}:8642", "--env-file", str(env_path),
                        probe["imageId"], "gateway", "run", "--no-supervise", "--force")
        wait_hermes(api)
        env = os.environ.copy()
        env.update({"LUMEN_DATA_DIR": str(work), "LUMEN_HERMES_PROFILE": "development",
                    "LUMEN_HERMES_BASE_URL": "http://127.0.0.1:9",
                    "LUMEN_HERMES_BEARER_FILE": str(work / "hermes.token"),
                    "LUMEN_CHAT_BASE_URL": api, "LUMEN_CHAT_BEARER_FILE": str(work / "chat.token"),
                    "LUMEN_CHAT_CONTAINER_ID": container, "LUMEN_CHAT_CONFIG_FILE": str(config),
                    "LUMEN_CHAT_PROBE_FILE": str(probe_path), "LUMEN_CHAT_PROVIDER_URL": route["url"],
                    "LUMEN_CHAT_PROVIDER_KEY_FILE": str(work / "provider.key"),
                    "LUMEN_CHAT_MODEL": route["model"]})
        run(str(binary), "init", env=env)
        log = (work / "host.log").open("w")
        host = subprocess.Popen([str(binary), "serve", "--manual"], env=env, stdout=log, stderr=subprocess.STDOUT)
        wait_ready(str(binary), env)
        run(str(binary), "conversation", "create", "--request_id", "real-create",
            "--conversation_id", "real-chat", "--surface_id", "mac-terminal", env=env)
        receipt = json.loads(run(str(binary), "conversation", "send", "--request_id", "real-send",
            "--conversation_id", "real-chat", "--surface_id", "mac-terminal",
            "--input", prompt, env=env))
        view = json.loads(run(str(binary), "conversation", "show", "--conversation_id", "real-chat", env=env))
        if view["messages"][-1]["role"] != "assistant" or not view["messages"][-1]["text"]:
            raise RuntimeError(f"Hermes produced no verified assistant reply; outcome={receipt.get('outcome')}; "
                               f"provider={provider_error_class(container)}; roles={[m['role'] for m in view['messages']]}")
        print(json.dumps({"status": "real_chat_passed", "model": route["model"],
                          "reply": view["messages"][-1]["text"]}))
        failed = False
    except Exception:
        if log is not None:
            log.flush()
            events = []
            for line in (work / "host.log").read_text(errors="replace").splitlines():
                match = re.search(r'\bevent=([a-z_]+)', line)
                if match:
                    events.append(match.group(1))
            print(json.dumps({"host_events": events[-12:]}), file=sys.stderr)
        raise
    finally:
        if host is not None and host.poll() is None:
            host.terminate()
            host.wait(timeout=10)
        if log is not None:
            log.close()
        if container:
            if failed:
                result = subprocess.run(["docker", "logs", container], capture_output=True)
                docker_log = work / "docker.log"
                docker_log.write_bytes(result.stdout + result.stderr)
                docker_log.chmod(0o600)
            subprocess.run(["docker", "stop", "--timeout", "5", container],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        if failed:
            for name in ("provider.key", "container.env", "chat.token", "hermes.token"):
                (work / name).unlink(missing_ok=True)
            print(f"Private diagnostic logs: {work}", file=sys.stderr)
        else:
            shutil.rmtree(work)


if __name__ == "__main__":
    main()
