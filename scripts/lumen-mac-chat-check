#!/usr/bin/env python3
"""Run an isolated native Host against a probed, synthetic Hermes chat container."""

import json
import os
import secrets
from contextlib import nullcontext
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from threading import Thread
import time
from http.server import ThreadingHTTPServer

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "integrations/hermes"))
from live_chat_probe import free_port, provider_class, request  # noqa: E402


def run(*args, env=None):
    result = subprocess.run(args, cwd=ROOT, env=env, text=True, capture_output=True,
                            timeout=60)
    if result.returncode:
        raise RuntimeError(f"{Path(args[0]).name} failed: {result.stderr.strip()}")
    return result.stdout.strip()


def wait_ready(binary, env):
    for _ in range(60):
        try:
            run(binary, "status", env=env)
            return
        except (RuntimeError, subprocess.TimeoutExpired):
            time.sleep(0.25)
    raise TimeoutError("Lumen Host did not become ready")


def wait_hermes(api):
    for _ in range(120):
        try:
            if request(api + "/health").get("status") == "ok":
                return
        except Exception:
            time.sleep(0.25)
    raise TimeoutError("dedicated Hermes chat container did not become ready")


def main():
    image = "lumen-hermes-chat:gate-test"
    probe = json.loads(run(sys.executable, str(ROOT / "integrations/hermes/container_chat_probe.py"),
                           "--image", image))
    if probe.get("status") != "container_probe_passed" or probe.get("rejectedToolCalls") != 3:
        raise AssertionError("Hermes chat image qualification failed")
    observed = []
    model_port, api_port = free_port(), free_port()
    while api_port == model_port:
        api_port = free_port()
    provider = ThreadingHTTPServer(("0.0.0.0", model_port), provider_class(observed))
    worker = Thread(target=provider.serve_forever, daemon=True)
    worker.start()
    container = ""
    host = None
    log_file = None
    work_path = tempfile.mkdtemp(prefix="lumen-mac-chat-")
    try:
        with nullcontext(work_path) as work:
            work = Path(work)
            binary = work / "lumen-host"
            run("go", "build", "-o", str(binary), "./cmd/lumen-host")
            token = secrets.token_urlsafe(32)
            for name in ("chat.token", "hermes.token"):
                path = work / name
                path.write_text(token)
                path.chmod(0o600)
            probe_path = work / "chat-probe.json"
            probe_path.write_text(json.dumps(probe))
            probe_path.chmod(0o600)
            config = (ROOT / "integrations/hermes/chat-config.yaml").resolve()
            api = f"http://127.0.0.1:{api_port}"
            container = run("docker", "run", "--detach", "--rm", "--read-only",
                            "--user", "65532:65532", "--add-host", "host.docker.internal:host-gateway",
                            "--tmpfs", "/var/lib/hermes:rw,uid=65532,gid=65532,mode=0700",
                            "--mount", f"type=bind,src={config},dst=/var/lib/hermes/config.yaml,readonly",
                            "--publish", f"127.0.0.1:{api_port}:8642",
                            "--env", "HERMES_HOME=/var/lib/hermes", "--env", "TERMINAL_CWD=/var/lib/hermes",
                            "--env", "HERMES_SAFE_MODE=1", "--env", "LUMEN_CHAT_ZERO_TOOL=1",
                            "--env", "API_SERVER_ENABLED=true", "--env", "API_SERVER_HOST=0.0.0.0",
                            "--env", "API_SERVER_PORT=8642", "--env", f"API_SERVER_KEY={token}",
                            "--env", "API_SERVER_MODEL_NAME=synthetic-model",
                            "--env", "HERMES_INFERENCE_PROVIDER=custom",
                            "--env", "HERMES_INFERENCE_MODEL=synthetic-model",
                            "--env", "OPENAI_API_KEY=synthetic-only",
                            "--env", f"OPENAI_BASE_URL=http://host.docker.internal:{model_port}/v1",
                            "--env", "OPENROUTER_API_KEY=synthetic-only",
                            "--env", f"OPENROUTER_BASE_URL=http://host.docker.internal:{model_port}/v1",
                            probe["imageId"], "gateway", "run", "--no-supervise", "--force")
            wait_hermes(api)
            env = os.environ.copy()
            env.update({"LUMEN_DATA_DIR": str(work), "LUMEN_HERMES_PROFILE": "development",
                        "LUMEN_HERMES_BASE_URL": "http://127.0.0.1:9",
                        "LUMEN_HERMES_BEARER_FILE": str(work / "hermes.token"),
                        "LUMEN_CHAT_BASE_URL": api, "LUMEN_CHAT_BEARER_FILE": str(work / "chat.token"),
                        "LUMEN_CHAT_CONTAINER_ID": container, "LUMEN_CHAT_CONFIG_FILE": str(config),
                        "LUMEN_CHAT_PROBE_FILE": str(probe_path),
                        "LUMEN_CHAT_PROVIDER_URL": f"http://host.docker.internal:{model_port}/v1"})
            run(str(binary), "init", env=env)
            log_file = (work / "host.log").open("w")

            def start_host():
                nonlocal host
                host = subprocess.Popen([str(binary), "serve"], env=env, stdout=log_file,
                                        stderr=subprocess.STDOUT)
                wait_ready(str(binary), env)

            def cli(*args):
                return json.loads(run(str(binary), *args, env=env))

            def send(request_id, text):
                cli("conversation", "send", "--request_id", request_id,
                    "--conversation_id", "one-space", "--surface_id", "terminal-a",
                    "--input", text)
                view = cli("conversation", "show", "--conversation_id", "one-space")
                if view["messages"][-1]["role"] != "assistant":
                    raise AssertionError("verified assistant message missing")
                return view

            start_host()
            cli("conversation", "create", "--request_id", "create-1",
                "--conversation_id", "one-space", "--surface_id", "terminal-a")
            first = send("send-1", "LUMEN_NORMAL_CHAT_PROBE first")
            cli("shutdown")
            host.wait(timeout=15)
            start_host()
            second = send("send-2", "LUMEN_NORMAL_CHAT_PROBE second")
            if len(second["messages"]) != len(first["messages"]) + 2:
                raise AssertionError("Host restart lost canonical conversation history")
            cli("memory", "save", "--request_id", "memory-1", "--memory_id", "fact-1",
                "--text", "I prefer concise answers")
            send("send-3", "LUMEN_NORMAL_CHAT_PROBE with memory")
            cli("memory", "delete", "--request_id", "delete-1", "--memory_id", "fact-1")
            send("send-4", "LUMEN_NORMAL_CHAT_PROBE after deletion")
            run("docker", "restart", container)
            wait_hermes(api)
            final = send("send-5", "LUMEN_NORMAL_CHAT_PROBE after Hermes restart")
            payloads = [json.dumps(body) for body in observed]
            if len(payloads) != 5 or "LUMEN_NORMAL_CHAT_PROBE first" not in payloads[1]:
                raise AssertionError("reconnected client did not receive Host-owned history")
            if "I prefer concise answers" not in payloads[2] or "I prefer concise answers" in payloads[3]:
                raise AssertionError("canonical memory save/delete did not change future context")
            if len(final["messages"]) != 10:
                raise AssertionError("Hermes restart lost canonical conversation messages")
            print(json.dumps({"status": "host_chat_journey_passed", "messages": len(final["messages"]),
                              "providerCalls": len(payloads), "imageId": probe["imageId"]}))
    finally:
        if sys.exc_info()[0] is not None and log_file is not None:
            log_file.flush()
            print((work / "host.log").read_text()[-3000:], file=sys.stderr)
        if host is not None and host.poll() is None:
            host.terminate()
            host.wait(timeout=10)
        if log_file is not None:
            log_file.close()
        if container:
            subprocess.run(["docker", "stop", "--timeout", "5", container],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        provider.shutdown()
        provider.server_close()
        worker.join(timeout=2)
        shutil.rmtree(work_path)


if __name__ == "__main__":
    main()
