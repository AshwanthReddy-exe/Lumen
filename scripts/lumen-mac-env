#!/bin/sh
set -eu

LUMEN_REPO_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
LUMEN_BINARY="$LUMEN_REPO_ROOT/build/lumen-host/lumen-host"
LUMEN_DATA_DIR=${LUMEN_DATA_DIR:-"$HOME/.local/share/lumen"}
LUMEN_SOCKET_PATH=${LUMEN_SOCKET_PATH:-"$LUMEN_DATA_DIR/host.sock"}
LUMEN_OPERATOR_CREDENTIAL_FILE=${LUMEN_OPERATOR_CREDENTIAL_FILE:-"$LUMEN_DATA_DIR/operator.credential"}
LUMEN_HERMES_BEARER_FILE=${LUMEN_HERMES_BEARER_FILE:-"$LUMEN_DATA_DIR/hermes.token"}
LUMEN_HERMES_PROFILE=${LUMEN_HERMES_PROFILE:-development}
LUMEN_HERMES_BASE_URL=${LUMEN_HERMES_BASE_URL:-http://127.0.0.1:8642}
LUMEN_LOG_FILE=${LUMEN_LOG_FILE:-"$LUMEN_DATA_DIR/host.log"}

export LUMEN_REPO_ROOT LUMEN_BINARY LUMEN_DATA_DIR LUMEN_SOCKET_PATH
export LUMEN_OPERATOR_CREDENTIAL_FILE LUMEN_HERMES_BEARER_FILE
export LUMEN_HERMES_PROFILE LUMEN_HERMES_BASE_URL
export LUMEN_LOG_FILE
