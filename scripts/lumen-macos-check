#!/bin/sh
# Native macOS journey: a Host running directly on darwin against the pinned
# Hermes gateway. The combined container topology is Linux-only, because the
# control socket requires an enforceable 0600 mode that a host-shared bind mount
# cannot provide (see deploy/README.md).
set -eu

repo_root=${LUMEN_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
compose_file=$repo_root/deploy/docker/compose.yaml
compose_override=$repo_root/deploy/docker/compose.milestone1.yaml
project=${COMPOSE_PROJECT_NAME:-lumen-macos-check-$$}
# Private state must live under $HOME: /tmp and /var are symlinks, and the Host
# refuses symlinked private paths.
work_root=${LUMEN_MACOS_CHECK_WORK_ROOT:-${HOME:?HOME is required}/.local/state}
mkdir -p "$work_root"
chmod 700 "$work_root"
work_dir=$(mktemp -d "$work_root/lumen-macos-check.XXXXXX")
data_dir=$work_dir/lumen-data
secret_dir=$work_dir/secrets
cli=$work_dir/lumen
host_artifact=$work_dir/lumen-host
archive=$work_dir/hermes-source.tar.gz
archive_target=$repo_root/hermes-source.tar.gz
archive_copied=0
compose_ready=0
host_pid=
proxy_pid=
api_key=
hermes_host_port=${LUMEN_HERMES_HOST_PORT:-28652}
provider_delay_ms=${LUMEN_PROVIDER_DELAY_MS:-10000}

cd "$repo_root"

compose() {
	docker compose -p "$project" -f "$compose_file" -f "$compose_override" "$@"
}

redact() {
	sed -E \
		-e 's/[Bb]earer[[:space:]]+[A-Za-z0-9._-]+/[Bearer REDACTED]/g' \
		-e "s/${api_key:-__unset__}/REDACTED/g" |
		grep -v 'hermes\.token'
}

cleanup() {
	status=$?
	if [ -n "$host_pid" ]; then
		kill "$host_pid" 2>/dev/null || :
	fi
	if [ -n "$proxy_pid" ]; then
		kill "$proxy_pid" 2>/dev/null || :
	fi
	if [ "$status" -ne 0 ] && [ "$compose_ready" -eq 1 ]; then
		printf '%s\n' '--- redacted macOS journey logs ---' >&2
		if ! compose logs --no-color 2>&1 | redact >&2; then
			:
		fi
		printf '%s\n' '--- end redacted logs ---' >&2
	fi
	if [ "$compose_ready" -eq 1 ]; then
		if ! compose down --volumes --remove-orphans >/dev/null 2>&1; then
			:
		fi
	fi
	if [ "$archive_copied" -eq 1 ]; then
		if ! rm -f -- "$archive_target"; then
			:
		fi
	fi
	if ! rm -rf -- "$work_dir"; then
		:
	fi
	exit "$status"
}
trap cleanup EXIT

fail() {
	printf 'lumen-macos-check: %s\n' "$1" >&2
	exit 1
}

[ "$(uname -s)" = Darwin ] || fail 'macOS is required for this journey'
command -v docker >/dev/null 2>&1 || fail 'Docker is required'
docker compose version >/dev/null 2>&1 || fail 'Docker Compose is required'
docker info >/dev/null 2>&1 || fail 'Docker daemon is unavailable'
command -v go >/dev/null 2>&1 || fail 'Go is required'
command -v curl >/dev/null 2>&1 || fail 'curl is required'
command -v jq >/dev/null 2>&1 || fail 'jq is required'
command -v zsh >/dev/null 2>&1 || fail 'zsh is required'
command -v shasum >/dev/null 2>&1 || fail 'shasum is required'
command -v python3 >/dev/null 2>&1 || fail 'python3 is required'

printf '%s\n' '=> private state'
mkdir -m 700 "$data_dir" "$secret_dir"
api_key=${LUMEN_HERMES_API_SERVER_KEY:-lumen-macos-check-api-key-20260925}
test "${#api_key}" -ge 16 || fail 'synthetic API server key must be at least 16 characters'
(umask 077
	printf '%s\n' "$api_key" >"$secret_dir/hermes.token")
chmod 600 "$secret_dir/hermes.token"

export LUMEN_DATA_DIR="$data_dir"
export LUMEN_SOCKET_PATH="$data_dir/host.sock"
export LUMEN_OPERATOR_CREDENTIAL_FILE="$data_dir/operator.credential"
export LUMEN_HERMES_BEARER_FILE="$secret_dir/hermes.token"
export LUMEN_HERMES_PROFILE=development
export LUMEN_HERMES_BASE_URL="http://127.0.0.1:$hermes_host_port"
export LUMEN_HERMES_API_SERVER_KEY="$api_key"
export LUMEN_HERMES_CONTAINER_BASE_URL=http://127.0.0.1:8642
export LUMEN_HERMES_HOST_PORT="$hermes_host_port"
export LUMEN_HERMES_TOKEN_SOURCE="$secret_dir/hermes.token"
export LUMEN_HERMES_CA_SOURCE="$secret_dir/hermes.token"
export LUMEN_HERMES_CLIENT_CERT_SOURCE="$secret_dir/hermes.token"
export LUMEN_HERMES_CLIENT_KEY_SOURCE="$secret_dir/hermes.token"
export LUMEN_PROVIDER_DELAY_MS="$provider_delay_ms"
export HERMES_COMMIT=2237be355906fbe6065ce1815711eee52b2d646e
export HERMES_SOURCE_ARCHIVE_SHA256=907c2a72db1c5dd637ea8eeae97f4cb5b32cef615c17258f6b190924ec5bf688
export COMPOSE_PROJECT_NAME="$project"
export COMPOSE_FILE=deploy/docker/compose.yaml:deploy/docker/compose.milestone1.yaml
export COMPOSE_PARALLEL_LIMIT=1
export LUMEN_HERMES_BUILD_IMAGE="$project-lumen-hermes:milestone1"

if [ -n "${LUMEN_HERMES_SOURCE_ARCHIVE:-}" ]; then
	cp -- "$LUMEN_HERMES_SOURCE_ARCHIVE" "$archive"
elif [ -s "$archive_target" ] && printf '%s  %s\n' "$HERMES_SOURCE_ARCHIVE_SHA256" "$archive_target" | shasum -a 256 -c - >/dev/null 2>&1; then
	printf '%s\n' '=> reusing previously verified Hermes source archive'
	cp -- "$archive_target" "$archive"
else
	attempt=0
	while [ "$attempt" -lt 5 ]; do
		if curl -fsSL --connect-timeout 10 --max-time 120 -o "$archive" \
			https://github.com/NousResearch/hermes-agent/archive/refs/tags/v2026.9.7.tar.gz; then
			break
		fi
		attempt=$((attempt + 1))
		[ "$attempt" -lt 5 ] || fail 'could not fetch the pinned Hermes source archive (GitHub rate limit?)'
		sleep $((attempt * 15))
	done
fi
printf '%s  %s\n' "$HERMES_SOURCE_ARCHIVE_SHA256" "$archive" | shasum -a 256 -c - >/dev/null
if [ -e "$archive_target" ]; then
	printf '%s  %s\n' "$HERMES_SOURCE_ARCHIVE_SHA256" "$archive_target" | shasum -a 256 -c - >/dev/null
else
	cp -- "$archive" "$archive_target"
	archive_copied=1
fi

printf '%s\n' '=> native Host build'
go build -trimpath -ldflags='-s -w' -o "$cli" ./cmd/lumen
go build -trimpath -ldflags='-s -w' -o "$host_artifact" ./cmd/lumen-host
chmod 700 "$cli" "$host_artifact"

printf '%s\n' '=> pinned Hermes gateway'
compose config >/dev/null
compose_ready=1
compose build lumen-hermes-init lumen-provider lumen-hermes
compose up -d lumen-provider lumen-hermes >/dev/null

wait_for_hermes() {
	i=0
	while [ "$i" -lt 120 ]; do
		if curl -fsS -m 3 -o /dev/null -H "Authorization: Bearer $api_key" \
			"$LUMEN_HERMES_BASE_URL/v1/capabilities" >/dev/null 2>&1; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	return 1
}

wait_for_hermes || fail 'pinned Hermes gateway did not become ready'

printf '%s\n' '=> one-shot E1 SSE interruption proxy'
export LUMEN_E1_UPSTREAM_PORT="$hermes_host_port"
export LUMEN_E1_PROXY_STATE="$work_dir/e1-proxy.json"
export LUMEN_E1_PROXY_ARM="$work_dir/e1-arm"
export LUMEN_E1_CREATE_DROP_ARM="$work_dir/e1-create-drop-arm"
export LUMEN_E1_GATEWAY_RESTART_ARM="$work_dir/e1-gateway-restart-arm"
python3 scripts/lumen-e1-proxy.py >"$work_dir/e1-proxy.log" 2>&1 &
proxy_pid=$!
i=0
while [ ! -s "$LUMEN_E1_PROXY_STATE" ] && [ "$i" -lt 20 ]; do
	i=$((i + 1))
	sleep 1
done
[ -s "$LUMEN_E1_PROXY_STATE" ] || fail 'E1 proxy did not start'
kill -0 "$proxy_pid" 2>/dev/null || fail 'E1 proxy exited after readiness'
e1_proxy_port=$(jq -er '.port | select(. > 0 and . < 65536)' "$LUMEN_E1_PROXY_STATE") || fail 'E1 proxy did not report a bound port'
curl -fsS -m 5 -o /dev/null -H "Authorization: Bearer $api_key" \
	"http://127.0.0.1:$e1_proxy_port/v1/capabilities" || fail 'E1 proxy did not forward authenticated discovery'
kill -0 "$proxy_pid" 2>/dev/null || fail 'E1 proxy exited before Host start'
export LUMEN_HERMES_BASE_URL="http://127.0.0.1:$e1_proxy_port"

printf '%s\n' '=> native Host start'
umask 077
"$host_artifact" init
"$host_artifact" serve >"$work_dir/host.log" 2>&1 &
host_pid=$!

wait_for_host() {
	i=0
	while [ "$i" -lt 60 ]; do
		if "$host_artifact" status >"$work_dir/host-status.json" 2>"$work_dir/host-status.err"; then
			return 0
		fi
		i=$((i + 1))
		sleep 1
	done
	redact <"$work_dir/host-status.err" >&2
	return 1
}

wait_for_host || fail 'native Host did not become ready'
host_node_id=$(jq -r '.active_host_id // .host_id // empty' "$work_dir/host-status.json")
[ -n "$host_node_id" ] || fail 'live Host status did not expose a node ID'

printf '%s\n' '=> configured synthetic task'
export LUMEN_BINARY="$host_artifact"
export LUMEN_TEST_TIMEOUT_SECONDS=${LUMEN_TEST_TIMEOUT_SECONDS:-180}
journey_output=$(zsh scripts/lumen-mac-test 2>&1) || {
	printf '%s\n' "$journey_output" | redact >&2
	fail 'macOS task journey did not reach a proven terminal result'
}
printf '%s\n' "$journey_output" | redact
printf '%s\n' "$journey_output" | grep -q 'synthetic marker' || fail 'task output did not match the pinned gateway response'

probe_suffix="$(date +%s)-$$"

printf '%s\n' '=> denial contract'
deny_now=$(date +%s)
deny_reconcile=$((deny_now + 120))
"$host_artifact" task submit \
	--request_id "macos-deny-submit-$probe_suffix" --task_id "macos-deny-$probe_suffix" \
	--capability_id agent.run/execute --action run \
	--action_fingerprint macos-deny-input --input 'deny probe' \
	--runtime_profile_digest dev-local-v1 --reconcile_by "$deny_reconcile" >/dev/null
"$host_artifact" approval resolve \
	--request_id "macos-deny-approve-$probe_suffix" --task_id "macos-deny-$probe_suffix" \
	--target_node_id "$host_node_id" --action_fingerprint macos-deny-input \
	--approval_id "macos-deny-approval-$probe_suffix" --approved_at "$deny_now" \
	--expires_at "$deny_reconcile" --reconcile_by "$deny_reconcile" \
	--runtime_profile_digest dev-local-v1 --input 'deny probe' --decision deny >/dev/null
sleep 2
denied=$("$host_artifact" task show --task_id "macos-deny-$probe_suffix")
[ "$(printf '%s' "$denied" | jq -r '.task.status')" = failed ] || fail 'a denied task did not fail closed'
[ "$(printf '%s' "$denied" | jq -r '.task.terminalReason')" = approval_denied ] || fail 'a denied task did not record approval_denied'
[ "$(printf '%s' "$denied" | jq -r '.task.output // empty')" = '' ] || fail 'a denied task produced output'
printf '%s\n' "$denied" | redact

printf '%s\n' '=> cancellation contract'
cancel_now=$(date +%s)
cancel_reconcile=$((cancel_now + 180))
"$host_artifact" task submit \
	--request_id "macos-cancel-submit-$probe_suffix" --task_id "macos-cancel-$probe_suffix" \
	--capability_id agent.run/execute --action run \
	--action_fingerprint macos-cancel-input --input 'cancel probe' \
	--runtime_profile_digest dev-local-v1 --reconcile_by "$cancel_reconcile" >/dev/null
"$host_artifact" approval resolve \
	--request_id "macos-cancel-approve-$probe_suffix" --task_id "macos-cancel-$probe_suffix" \
	--target_node_id "$host_node_id" --action_fingerprint macos-cancel-input \
	--approval_id "macos-cancel-approval-$probe_suffix" --approved_at "$cancel_now" \
	--expires_at "$cancel_reconcile" --reconcile_by "$cancel_reconcile" \
	--runtime_profile_digest dev-local-v1 --input 'cancel probe' --decision once >/dev/null
"$host_artifact" task cancel \
	--request_id "macos-cancel-request-$probe_suffix" --task_id "macos-cancel-$probe_suffix" >/dev/null

cancelled_status=
i=0
while [ "$i" -lt 60 ]; do
	shown=$("$host_artifact" task show --task_id "macos-cancel-$probe_suffix") || fail 'task status unavailable during cancellation'
	cancelled_status=$(printf '%s' "$shown" | jq -r '.task.status')
	case "$cancelled_status" in
		cancelled)
			[ "$(printf '%s' "$shown" | jq -r '.task.output // empty')" = '' ] || fail 'a cancelled task produced output'
			printf '%s\n' "$shown" | redact
			break
			;;
		failed|completed|unknown_outcome)
			printf '%s\n' "$shown" | redact >&2
			fail "cancellation reached $cancelled_status instead of cancelled"
			;;
	esac
	i=$((i + 1))
	sleep 1
done
[ "$cancelled_status" = cancelled ] || fail 'cancellation did not converge'

printf '%s\n' '=> pinned E1 gateway restart'
gateway_creates_before=$(jq -r '.creates' "$LUMEN_E1_PROXY_STATE")
gateway_now=$(date +%s)
gateway_reconcile=$((gateway_now + 180))
gateway_task="macos-gateway-restart-$probe_suffix"
gateway_request="macos-gateway-restart-submit-$probe_suffix"
printf '%s\n' "$gateway_request" >"$LUMEN_E1_GATEWAY_RESTART_ARM"
"$host_artifact" task submit \
	--request_id "$gateway_request" --task_id "$gateway_task" \
	--capability_id agent.run/execute --action run \
	--action_fingerprint macos-gateway-restart-input --input 'E1 gateway restart probe' \
	--runtime_profile_digest dev-local-v1 --reconcile_by "$gateway_reconcile" >/dev/null
"$host_artifact" approval resolve \
	--request_id "macos-gateway-restart-approve-$probe_suffix" --task_id "$gateway_task" \
	--target_node_id "$host_node_id" --action_fingerprint macos-gateway-restart-input \
	--approval_id "macos-gateway-restart-approval-$probe_suffix" --approved_at "$gateway_now" \
	--expires_at "$gateway_reconcile" --reconcile_by "$gateway_reconcile" \
	--runtime_profile_digest dev-local-v1 --input 'E1 gateway restart probe' --decision once >/dev/null
i=0
gateway_run=
while [ "$i" -lt 60 ]; do
	gateway_run=$(jq -r '.gateway_restart_run_id // empty' "$LUMEN_E1_PROXY_STATE")
	[ -n "$gateway_run" ] && break
	i=$((i + 1))
	sleep 1
done
[ -n "$gateway_run" ] || fail 'gateway restart probe did not capture the pinned Run ID'
[ "$(jq -r '.gateway_restart_creates' "$LUMEN_E1_PROXY_STATE")" -eq 1 ] || fail 'gateway restart task issued multiple Run creates'
gateway_before_status=$(curl -fsS -m 5 -H "Authorization: Bearer $api_key" \
	"http://127.0.0.1:$hermes_host_port/v1/runs/$gateway_run" | jq -r '.status')
case "$gateway_before_status" in
	started|running) ;;
	*) fail "gateway restart probe was not active before restart: $gateway_before_status" ;;
esac
gateway_before_host=$(
	"$host_artifact" task show --task_id "$gateway_task" | jq -r '.task.status'
)
case "$gateway_before_host" in
	dispatched|running) ;;
	*) fail "Host task was not in flight before Hermes restart: $gateway_before_host" ;;
esac
compose restart lumen-hermes >/dev/null
wait_for_hermes || fail 'pinned Hermes gateway did not recover after container restart'
gateway_status=
gateway_host_status=
i=0
while [ "$i" -lt 180 ]; do
	if gateway_status=$(curl -fsS -m 5 -H "Authorization: Bearer $api_key" \
		"http://127.0.0.1:$hermes_host_port/v1/runs/$gateway_run" 2>/dev/null | jq -r '.status'); then
		:
	else
		gateway_status=
	fi
	gateway_shown=$("$host_artifact" task show --task_id "$gateway_task") || fail 'gateway restart task unavailable from Host'
	gateway_host_status=$(printf '%s' "$gateway_shown" | jq -r '.task.status')
	if [ "$gateway_status" = completed ] && [ "$gateway_host_status" = completed ]; then
		break
	fi
	case "$gateway_status:$gateway_host_status" in
		failed:*|*:failed|cancelled:*|*:cancelled|unknown_outcome:*|*:unknown_outcome)
			printf 'E1 gateway restart: task=%s run=%s runtime=%s host=%s\n' \
				"$gateway_task" "$gateway_run" "$gateway_status" "$gateway_host_status" >&2
			fail 'gateway or Host did not recover the in-flight task to completed' ;;
	esac
	i=$((i + 1))
	sleep 1
done
[ "$gateway_status" = completed ] || fail "gateway Run did not complete after restart: $gateway_status"
[ "$gateway_host_status" = completed ] || fail "Host did not reconcile gateway restart: $gateway_host_status"
[ "$(jq -r '.gateway_restart_creates' "$LUMEN_E1_PROXY_STATE")" -eq 1 ] || fail 'gateway restart task issued more than one POST /v1/runs'
[ "$(jq -r '.creates' "$LUMEN_E1_PROXY_STATE")" -eq "$((gateway_creates_before + 1))" ] || fail 'unexpected Run create during gateway restart probe'
[ "$(printf '%s' "$gateway_shown" | jq -r '.run.runtimeRunId')" = "$gateway_run" ] || fail 'Host Run mapping changed across gateway restart'
gateway_host_output=$(printf '%s' "$gateway_shown" | jq -r '.task.output // empty')
[ -n "$gateway_host_output" ] || fail 'Hermes and Host reported completed after gateway restart without durable output'
gateway_runtime_json=$(curl -fsS -m 5 -H "Authorization: Bearer $api_key" \
	"http://127.0.0.1:$hermes_host_port/v1/runs/$gateway_run")
gateway_runtime_output=$(printf '%s' "$gateway_runtime_json" | jq -r '.output // empty')
[ "$gateway_host_output" = "$gateway_runtime_output" ] || fail 'Host output differs from pinned Run status after gateway restart'
case "$gateway_host_output" in
	'Operation interrupted: waiting for model response ('*) ;;
	*) fail 'gateway restart returned an unrecognized durable output' ;;
esac
printf 'E1 gateway restart: task=%s run=%s before_runtime=%s before_host=%s after_runtime=%s after_host=%s creates_for_task=1 host_mapping_preserved=true output=interrupted host_runtime_output_match=true\n' \
	"$gateway_task" "$gateway_run" "$gateway_before_status" "$gateway_before_host" \
	"$gateway_status" "$gateway_host_status"

printf '%s\n' '=> pinned E1 stream cut and Host restart'
e1_creates_before=$(jq -r '.creates' "$LUMEN_E1_PROXY_STATE")
printf '%s\n' "macos-e1-submit-$probe_suffix" >"$LUMEN_E1_PROXY_ARM"
e1_now=$(date +%s)
e1_reconcile=$((e1_now + 180))
e1_task="macos-e1-$probe_suffix"
"$host_artifact" task submit \
	--request_id "macos-e1-submit-$probe_suffix" --task_id "$e1_task" \
	--capability_id agent.run/execute --action run \
	--action_fingerprint macos-e1-input --input 'E1 stream interruption probe' \
	--runtime_profile_digest dev-local-v1 --reconcile_by "$e1_reconcile" >/dev/null
"$host_artifact" approval resolve \
	--request_id "macos-e1-approve-$probe_suffix" --task_id "$e1_task" \
	--target_node_id "$host_node_id" --action_fingerprint macos-e1-input \
	--approval_id "macos-e1-approval-$probe_suffix" --approved_at "$e1_now" \
	--expires_at "$e1_reconcile" --reconcile_by "$e1_reconcile" \
	--runtime_profile_digest dev-local-v1 --input 'E1 stream interruption probe' --decision once >/dev/null
i=0
while [ "$(jq -r '.cut_event' "$LUMEN_E1_PROXY_STATE")" != true ] && [ "$i" -lt 60 ]; do
	i=$((i + 1))
	sleep 1
done
[ "$(jq -r '.cut_event' "$LUMEN_E1_PROXY_STATE")" = true ] || fail 'no complete pinned SSE event was cut'
state_before_observation=$(shasum -a 256 "$data_dir/state.json" | cut -d ' ' -f 1)
prekill=$("$host_artifact" task show --task_id "$e1_task") || fail 'E1 task unavailable before Host interruption'
prekill_status=$(printf '%s' "$prekill" | jq -r '.task.status')
case "$prekill_status" in
	dispatched|running) ;;
	*) fail "E1 task was not durably in flight before Host interruption: $prekill_status" ;;
esac
e1_run=$(jq -r '.run_id' "$LUMEN_E1_PROXY_STATE")
[ "$(printf '%s' "$prekill" | jq -r '.run.runtimeRunId')" = "$e1_run" ] || fail 'prekill durable Host run mapping differs from interrupted SSE run'
printf 'E1 prekill: task=%s run=%s status=%s cut_event=true\n' "$e1_task" "$e1_run" "$prekill_status"
state_before_kill=$(shasum -a 256 "$data_dir/state.json" | cut -d ' ' -f 1)
[ "$state_before_observation" = "$state_before_kill" ] || fail 'canonical state changed during in-flight observation'
kill -KILL "$host_pid"
wait "$host_pid" 2>/dev/null || :
host_pid=
state_after_kill=$(shasum -a 256 "$data_dir/state.json" | cut -d ' ' -f 1)
[ "$state_before_kill" = "$state_after_kill" ] || fail 'canonical state changed between in-flight observation and Host exit'
"$host_artifact" serve >"$work_dir/host-restart.log" 2>&1 &
host_pid=$!
wait_for_host || fail 'Host did not restart against the same canonical state'
restarted_host_node_id=$(jq -r '.active_host_id // .host_id // empty' "$work_dir/host-status.json")
[ "$restarted_host_node_id" = "$host_node_id" ] || fail 'Host identity changed after restart'
e1_status=
i=0
while [ "$i" -lt 180 ]; do
	shown=$("$host_artifact" task show --task_id "$e1_task") || fail 'E1 task status unavailable after restart'
	e1_status=$(printf '%s' "$shown" | jq -r '.task.status')
	case "$e1_status" in
		completed|failed|cancelled) break ;;
	esac
	i=$((i + 1))
	sleep 1
done
[ "$(jq -r '.creates' "$LUMEN_E1_PROXY_STATE")" -eq "$((e1_creates_before + 1))" ] || fail 'E1 did not issue exactly one POST /v1/runs'
[ "$(jq -r '.e1_creates' "$LUMEN_E1_PROXY_STATE")" -eq 1 ] || fail 'E1 idempotency key did not issue exactly one POST /v1/runs'
[ "$(printf '%s' "$shown" | jq -r '.run.runtimeRunId')" = "$e1_run" ] || fail 'durable Host run mapping differs from interrupted SSE run'
runtime_status=$(curl -fsS -m 5 -H "Authorization: Bearer $api_key" \
	"http://127.0.0.1:$hermes_host_port/v1/runs/$e1_run" | jq -r '.status')
printf 'E1 postrestart: task=%s run=%s prekill_status=%s durable_status=%s runtime_status=%s creates_for_task=1 host_id_preserved=true state_unchanged_at_exit=true\n' \
	"$e1_task" "$e1_run" "$prekill_status" "$e1_status" "$runtime_status"
[ "$runtime_status" = completed ] || fail "pinned E1 runtime ended as $runtime_status"
[ "$e1_status" = completed ] || fail "Host did not reconcile pinned E1 completion: $e1_status"
printf 'E1: task=%s run=%s event_type=%s event_id=%s creates_for_task=1 prekill_status=%s durable_status=%s runtime_status=%s host_id_preserved=true\n' \
	"$e1_task" "$(jq -r '.run_id' "$LUMEN_E1_PROXY_STATE")" \
	"$(jq -r '.event_type' "$LUMEN_E1_PROXY_STATE")" \
	"$(jq -r '.event_id' "$LUMEN_E1_PROXY_STATE")" "$prekill_status" "$e1_status" "$runtime_status"

if [ "${LUMEN_E1_AMBIGUOUS_CREATE:-0}" = 1 ]; then
	printf '%s\n' '=> pinned E1 ambiguous create response'
	ambiguous_now=$(date +%s)
	ambiguous_reconcile=$((ambiguous_now + 20))
	ambiguous_task="macos-ambiguous-$probe_suffix"
	ambiguous_request="macos-ambiguous-submit-$probe_suffix"
	ambiguous_creates_before=$(jq -r '.creates' "$LUMEN_E1_PROXY_STATE")
	printf '%s\n' "$ambiguous_request" >"$LUMEN_E1_CREATE_DROP_ARM"
	"$host_artifact" task submit \
		--request_id "$ambiguous_request" --task_id "$ambiguous_task" \
		--capability_id agent.run/execute --action run \
		--action_fingerprint macos-ambiguous-input --input 'E1 ambiguous create probe' \
		--runtime_profile_digest dev-local-v1 --reconcile_by "$ambiguous_reconcile" >/dev/null
	"$host_artifact" approval resolve \
		--request_id "macos-ambiguous-approve-$probe_suffix" --task_id "$ambiguous_task" \
		--target_node_id "$host_node_id" --action_fingerprint macos-ambiguous-input \
		--approval_id "macos-ambiguous-approval-$probe_suffix" --approved_at "$ambiguous_now" \
		--expires_at "$ambiguous_reconcile" --reconcile_by "$ambiguous_reconcile" \
		--runtime_profile_digest dev-local-v1 --input 'E1 ambiguous create probe' --decision once >/dev/null
	i=0
	while [ "$i" -lt 30 ]; do
		ambiguous_shown=$("$host_artifact" task show --task_id "$ambiguous_task") || fail 'ambiguous task status unavailable'
		ambiguous_status=$(printf '%s' "$ambiguous_shown" | jq -r '.task.status')
		[ "$ambiguous_status" = unknown_outcome ] && break
		i=$((i + 1))
		sleep 1
	done
	[ "$ambiguous_status" = unknown_outcome ] || fail "ambiguous create did not produce durable unknown_outcome: $ambiguous_status"
	while [ "$(date +%s)" -le "$ambiguous_reconcile" ]; do
		sleep 1
	done
	ambiguous_shown=$("$host_artifact" task show --task_id "$ambiguous_task") || fail 'ambiguous task status unavailable after reconcile deadline'
	ambiguous_status=$(printf '%s' "$ambiguous_shown" | jq -r '.task.status')
	[ "$ambiguous_status" = unknown_outcome ] || fail "ambiguous create changed after reconcile deadline: $ambiguous_status"
	[ "$(jq -r '.create_dropped' "$LUMEN_E1_PROXY_STATE")" = true ] || fail 'pinned create response was not captured and dropped'
	[ "$(jq -r '.ambiguous_creates' "$LUMEN_E1_PROXY_STATE")" -eq 1 ] || fail 'ambiguous create idempotency key was posted more than once'
	[ "$(jq -r '.creates' "$LUMEN_E1_PROXY_STATE")" -eq "$((ambiguous_creates_before + 1))" ] || fail 'additional Run create occurred during ambiguous probe'
	[ "$(printf '%s' "$ambiguous_shown" | jq -r '.run.runtimeRunId // empty')" = '' ] || fail 'ambiguous create invented a durable Run mapping'
	[ "$(printf '%s' "$ambiguous_shown" | jq -r '.task.output // empty')" = '' ] || fail 'ambiguous create invented completed output'
	ambiguous_run=$(jq -r '.ambiguous_run_id' "$LUMEN_E1_PROXY_STATE")
	[ -n "$ambiguous_run" ] || fail 'pinned gateway did not return a run ID for ambiguous create'
	ambiguous_runtime_status=$(curl -fsS -m 5 -H "Authorization: Bearer $api_key" \
		"http://127.0.0.1:$hermes_host_port/v1/runs/$ambiguous_run" | jq -r '.status')
	[ "$ambiguous_runtime_status" = completed ] || fail "pinned Hermes run did not complete after Host response loss: $ambiguous_runtime_status"
	printf 'E1 ambiguous: task=%s runtime_run=%s host_status=%s host_mapping=none creates_for_key=1 runtime_status=%s\n' \
		"$ambiguous_task" "$ambiguous_run" "$ambiguous_status" "$ambiguous_runtime_status"
fi

printf '%s\n' 'All native macOS journey checkpoints passed.'
if [ "${LUMEN_MACOS_CHECK_PRESERVE:-0}" = 1 ]; then
	printf 'preserved work directory: %s\n' "$work_dir"
	printf 'preserved Compose project: %s\n' "$project"
	trap - EXIT
fi
