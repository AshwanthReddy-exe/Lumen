#!/bin/sh
set -eu

repo_root=${LUMEN_REPO_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}
project=${COMPOSE_PROJECT_NAME:-lumen-external-check-$$}
hermes_project=${project}-hermes
port=${LUMEN_EXTERNAL_HERMES_HOST_PORT:-28643}
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/lumen-external-check.XXXXXX")
data_dir=$work_dir/lumen-data
secret_dir=$work_dir/secrets
manifest=$work_dir/manifest.json
artifact=$work_dir/lumen-host
hermes_container=${hermes_project}-endpoint
hermes_id=
compose_ready=0

cd "$repo_root"

compose() {
	docker compose -p "$project" -f deploy/docker/compose.external.yaml "$@"
}

cleanup() {
	status=$?
	if [ "$status" -ne 0 ] && [ "$compose_ready" -eq 1 ]; then
		printf '%s\n' '--- redacted external journey logs ---' >&2
		compose logs --no-color 2>&1 | sed -E 's/(Bearer[[:space:]]+)[A-Za-z0-9._-]+/\1REDACTED/g' >&2 || :
		printf '%s\n' '--- end redacted logs ---' >&2
	fi
	if [ "$compose_ready" -eq 1 ]; then
		# docker compose down --volumes is the owned Host cleanup boundary.
		compose down --volumes --remove-orphans >/dev/null 2>&1 || :
	fi
	docker rm -f "$hermes_container" >/dev/null 2>&1 || :
	rm -rf -- "$work_dir"
	exit "$status"
}
trap cleanup EXIT

fail() { printf 'lumen-external-check: %s\n' "$1" >&2; exit 1; }
[ "$(uname -s)" = Linux ] || fail 'Linux is required for this journey'
command -v docker >/dev/null 2>&1 || fail 'Docker is required'
docker info >/dev/null 2>&1 || fail 'Docker daemon is unavailable'
docker compose version >/dev/null 2>&1 || fail 'Docker Compose is required'
command -v go >/dev/null 2>&1 || fail 'Go is required'

	printf '%s\n' '=> external Hermes endpoint (independent Hermes lifecycle)'
mkdir -m 700 "$data_dir" "$secret_dir"
(umask 077; printf '%s\n' 'lumen-external-check-token' >"$secret_dir/hermes.token")
chmod 600 "$secret_dir/hermes.token"

cat >"$work_dir/hermes.py" <<'PY'
import json
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

class Hermes(BaseHTTPRequestHandler):
    def log_message(self, *_): pass
    def auth(self):
        return self.headers.get("Authorization") == "Bearer lumen-external-check-token"
    def send_json(self, value, status=200):
        body = json.dumps(value).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def do_GET(self):
        if not self.auth(): self.send_json({"error":"unauthorized"}, 401); return
        if self.path == "/health": self.send_json({"status":"ok","version":"0.21.1"}); return
        if self.path == "/v1/capabilities":
            self.send_json({"object":"hermes.api_server.capabilities","platform":"hermes-agent","model":"external-check","auth":{"type":"bearer","required":True},"features":{"run_submission":True,"run_status":True,"run_events_sse":True,"run_approval_response":True,"run_stop":True},"endpoints":{"runs":"/v1/runs"},"runtime":{"version":"0.21.1"}}); return
        if self.path == "/v1/runs/external-check-run": self.send_json({"id":"external-check-run","status":"completed","result":{"output":"external marker"}}); return
        self.send_json({"error":"not found"}, 404)
    def do_POST(self):
        if not self.auth(): self.send_json({"error":"unauthorized"}, 401); return
        if self.path != "/v1/runs": self.send_json({"error":"not found"}, 404); return
        self.send_json({"id":"external-check-run","status":"completed"})

ThreadingHTTPServer(("0.0.0.0", 8080), Hermes).serve_forever()
PY

docker run -d --name "$hermes_container" --restart unless-stopped -p "0.0.0.0:$port:8080" -v "$work_dir/hermes.py:/hermes.py:ro" python:3.12-alpine python -u /hermes.py >/dev/null
# external Hermes container is independently supervised from the Host Compose project.
hermes_id=$(docker inspect --format '{{.Id}}' "$hermes_container")
endpoint="http://host.docker.internal:$port"
export LUMEN_DATA_DIR="$data_dir"
export LUMEN_HERMES_CREDENTIAL_FILE="$secret_dir/hermes.token"
export LUMEN_HERMES_TOKEN_SOURCE="$secret_dir/hermes.token"
export LUMEN_HERMES_CA_SOURCE="$secret_dir/hermes.token"
export LUMEN_HERMES_CLIENT_CERT_SOURCE="$secret_dir/hermes.token"
export LUMEN_HERMES_CLIENT_KEY_SOURCE="$secret_dir/hermes.token"
export LUMEN_HERMES_BASE_URL="$endpoint"
export LUMEN_HERMES_PROFILE=development
export LUMEN_HERMES_SERVER_CERT_PIN=$(sha256sum "$secret_dir/hermes.token" | cut -d' ' -f1)
export LUMEN_SETUP_PROFILE=development
export LUMEN_SETUP_TOPOLOGY=external
export LUMEN_SUPERVISOR=docker
export LUMEN_HOST_USER="$(id -u):$(id -g)"
export COMPOSE_PROJECT_NAME="$project"
export COMPOSE_FILE=deploy/docker/compose.yaml

printf '%s\n' '=> build Host artifact and external manifest'
CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o "$artifact" ./cmd/lumen-host
chmod 700 "$artifact"
artifact_sha=$(sha256sum "$artifact" | cut -d' ' -f1)
artifact_size=$(wc -c <"$artifact" | tr -d ' ')
cat >"$manifest" <<EOF
{"schemaVersion":1,"topology":"external","artifacts":[{"name":"lumen","version":"external-check","os":"linux","architecture":"amd64","profile":"development","url":"https://example.invalid/lumen","size":$artifact_size,"sha256":"sha256:$artifact_sha","contractVersion":1,"executableMode":448,"ownership":"lumen"}]}
EOF
export LUMEN_MANIFEST="$manifest"
export LUMEN_LUMEN_ARTIFACT="$artifact"

printf '%s\n' '=> lumen setup'
compose up -d --build
compose_ready=1
compose ps --status running -q lumen-host >/dev/null || fail 'external Host is not running'
"$artifact" setup | tee "$work_dir/setup.json" | grep -q '"outcome":"ready"' || fail 'external setup did not report ready'
printf '%s\n' '=> rerun'
"$artifact" setup | grep -q '"outcome":"ready"' || fail 'external setup rerun did not report ready'
printf '%s\n' '=> lumen doctor'
"$artifact" doctor | tee "$work_dir/doctor.json" | grep -q '"outcome":"ready"' || fail 'external doctor did not report ready'

state_before=$(sha256sum "$data_dir/space.state" | cut -d' ' -f1)
hermes_before=$(docker inspect --format '{{.Id}} {{.State.Status}}' "$hermes_container")
printf '%s\n' '=> Host-only service restart'
"$artifact" service restart | grep -q '"outcome":"ready"' || fail 'Host-only restart failed'
hermes_after_restart=$(docker inspect --format '{{.Id}} {{.State.Status}}' "$hermes_container")
[ "$hermes_before" = "$hermes_after_restart" ] || fail 'Host-only restart changed external Hermes'
printf '%s\n' '=> Host-only service stop/start'
"$artifact" service stop | grep -q '"outcome":"ready"' || fail 'Host-only stop failed'
"$artifact" service start | grep -q '"outcome":"ready"' || fail 'Host-only start failed'
hermes_after_start=$(docker inspect --format '{{.Id}} {{.State.Status}}' "$hermes_container")
[ "$hermes_before" = "$hermes_after_start" ] || fail 'Host-only stop/start changed external Hermes'
state_after=$(sha256sum "$data_dir/space.state" | cut -d' ' -f1)
[ "$state_before" = "$state_after" ] || fail 'state preservation check failed'
printf '%s\n' 'external Hermes never controls Hermes lifecycle; state preservation passed'
