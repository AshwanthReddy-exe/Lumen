[Unit]
Description=Lumen Hermes adapter
After=network-online.target
[Service]
Type=simple
ExecStart=/usr/local/bin/hermes serve
EnvironmentFile=-/etc/lumen/hermes.env
User=lumen
Group=lumen
UMask=0077
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3
KillSignal=SIGTERM
TimeoutStopSec=30s
[Install]
WantedBy=multi-user.target
