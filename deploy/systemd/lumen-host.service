[Unit]
Description=Lumen headless Host
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/lumen-host serve
EnvironmentFile=-/etc/lumen/host.env
User=lumen
Group=lumen
WorkingDirectory=/var/lib/lumen
StateDirectory=lumen
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lumen
KillSignal=SIGTERM
TimeoutStopSec=30s
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60s
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
