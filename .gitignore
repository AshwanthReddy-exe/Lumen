.DS_Store

# Local tool state
.mise.local.toml

# Gradle and Kotlin
.gradle/
.kotlin/
**/build/

# Python probe bytecode
__pycache__/
*.pyc

# Swift Package Manager and Xcode
.build/
.swiftpm/
DerivedData/

# Machine-specific SDK configuration
local.properties

# Local credentials
*.pem
/ssh-key-*.key
/ssh-key-*.key.pub

# Per-machine agent settings and generated repository graph
.agents/
.codex/
.superpowers/
graphify-out/
.worktrees/
.freebuff/

# External reference material: read-only, never part of Lumen product history
references/

# Pinned upstream source archive used as a Docker build context input
hermes-source.tar.gz
/.lumen-e2-hermes-source.*

# Generated embedded browser bundle; keep the tracked compile-time sentinel
/internal/host/web/dist/*
!/internal/host/web/dist/.keep

# Generated managed-service web bundle; keep Go embed directory present
/cmd/lumen-managed/web/dist/*
!/cmd/lumen-managed/web/dist/.keep
